{
  "name": "bracha-qa",
  "private": true,
  "description": "כלי הבדיקה של הבאת ברכה — playwright + axe-core",
  "scripts": {
    "serve": "python -m http.server 8765 --bind 127.0.0.1",
    "qa:smoke": "node .claude/skills/bracha-qa/scripts/smoke.cjs",
    "qa:axe": "node .claude/skills/bracha-qa/scripts/axe.cjs",
    "qa:inventory": "python .claude/skills/bracha-qa/scripts/inventory.py",
    "qa:notes": "python .claude/skills/bracha-qa/scripts/notes-table.py",
    "qa:report": "python .claude/skills/bracha-qa/scripts/report.py",
    "qa": "npm run qa:smoke && npm run qa:axe && npm run qa:inventory && npm run qa:notes && npm run qa:report"
  },
  "devDependencies": { "playwright": "^1.56.0", "axe-core": "^4.10.0" }
}
